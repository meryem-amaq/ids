# ============================================================
# RELAIS CLOUD PUBLIC IDS — VARIABLES D'ENVIRONNEMENT
# Ce fichier sert d'exemple pour déployer le serveur relais
# sur N'IMPORTE QUEL HÉBERGEUR (Heroku, Render, Railway, VPS Ubuntu, Docker, etc.)
# ============================================================

# 1. Port d'écoute du serveur web (défini automatiquement sur Heroku/Render)
PORT=5001

# 2. Environnement (production ou development)
NODE_ENV=production

# 3. Base de données MySQL distante (Ex: JawsDB sur Heroku, Clever Cloud, Aiven, PlanetScale, ou MySQL local)
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
JAWSDB_URL=mysql://root:password@127.0.0.1:3306/ids_cloud_db

# 4. Clé secrète de synchronisation et de signature des liens 1-clic (DOIT ÊTRE IDENTIQUE AU SERVEUR LOCAL)
SYNC_SECRET=ids_secret_sync_key_987654321_secure

# 5. Secret de synchronisation de la liste blanche des porteurs autorisés
WHITELIST_SECRET=MON_SECRET_DE_SYNC_123

# 6. (Optionnel) URL publique de ce serveur relais si hébergé avec un nom de domaine personnalisé
# CLOUD_URL=https://mon-domaine-relais.com

